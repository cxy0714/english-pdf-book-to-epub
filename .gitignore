# =============================================================================
# 本仓库只提交「代码」。
# 源 PDF、抽取出的英文底本、译文、对照稿、EPUB 等数据文件一律不入库。
# 见 README.md「仓库约定」。
# =============================================================================

# --- 源 PDF（版权文件，绝不提交）---
*.pdf
!docs/**/*.pdf

# --- 每本书的工作数据 ---
books/*/source/
books/*/sources/
books/*/build/
books/*/out/
books/*/qa/
books/*/images/
books/*/*.epub
books/*/*.md
# 但以下几类是配置，要入库
!books/*/book.json
!books/*/parts.json
!books/*/glossary.json
!books/*/README.md

# --- 全局配置（模板入库，含 key 的本地文件不入库）---
config/mt.local.json
config/*.local.json

# --- 本地凭证（绝不提交）---
books/*/mt.local.json
.env
.env.*

# --- 顶层生成物 ---
*.epub
对照稿/
样稿_*.md
科学_*.epub

# --- 中间目录 ---
.epub-build-*/
build/
dist/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- 本地调研/临时文件（不属于交付）---
_reference/
_scratch/
_run*.txt
_r?.txt
_pdf_probe*.txt
_probe*.py
_inspect_pdf.py